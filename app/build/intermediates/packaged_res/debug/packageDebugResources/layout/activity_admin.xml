<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F3F6FB" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SEBA" android:textSize="30sp" android:textStyle="bold" android:textColor="#10233F"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PANEL ADMINISTRATORA" android:textSize="13sp" android:textColor="#718096"
            android:layout_marginTop="3dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Wybierz rodzaj komunikatu" android:textSize="21sp" android:textStyle="bold"
            android:textColor="#10233F" android:layout_marginTop="42dp" android:layout_marginBottom="18dp"/>
        <TextView android:id="@+id/btnAlarm" android:layout_width="match_parent" android:layout_height="100dp"
            android:gravity="center" android:text="ALARM" android:textSize="24sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:background="@drawable/bg_alarm_button"/>
        <TextView android:id="@+id/btnOstrzezenie" android:layout_width="match_parent" android:layout_height="100dp"
            android:gravity="center" android:text="OSTRZEŻENIE" android:textSize="23sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:background="@drawable/bg_warning_button"
            android:layout_marginTop="18dp"/>
        <TextView android:id="@+id/buttonLogout" android:layout_width="match_parent" android:layout_height="52dp"
            android:gravity="center" android:text="WYLOGUJ" android:textColor="#526174"
            android:textStyle="bold" android:layout_marginTop="34dp"/>
    </LinearLayout>
</ScrollView>
