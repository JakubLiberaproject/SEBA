<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F3F6FB" android:fillViewport="true"
    android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp"
        android:paddingBottom="24dp" android:paddingTop="48dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SEBA" android:textSize="30sp" android:textStyle="bold" android:textColor="#10233F"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PANEL UŻYTKOWNIKA" android:textSize="13sp" android:textColor="#718096"
            android:layout_marginTop="3dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="OSTATNI KOMUNIKAT" android:textSize="12sp" android:textStyle="bold"
            android:textColor="#718096" android:layout_marginTop="28dp"/>
        <TextView android:id="@+id/textLatest" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Brak nowych komunikatów." android:textSize="16sp" android:textColor="#10233F"
            android:padding="18dp" android:background="@drawable/bg_card" android:layout_marginTop="9dp"/>
        <TextView android:id="@+id/buttonStopAlarm" android:layout_width="match_parent" android:layout_height="56dp"
            android:gravity="center" android:text="WYŁĄCZ ALARM" android:textColor="#FFFFFF"
            android:textStyle="bold" android:background="@drawable/bg_alarm_button" android:layout_marginTop="16dp"
            android:visibility="gone"/>
        <TextView android:id="@+id/buttonHistory" android:layout_width="match_parent" android:layout_height="56dp"
            android:gravity="center" android:text="HISTORIA KOMUNIKATÓW" android:textColor="#FFFFFF"
            android:textStyle="bold" android:background="@drawable/bg_primary_button" android:layout_marginTop="22dp"/>
        <TextView android:id="@+id/buttonLogout" android:layout_width="match_parent" android:layout_height="52dp"
            android:gravity="center" android:text="WYLOGUJ" android:textColor="#526174"
            android:textStyle="bold" android:layout_marginTop="10dp"/>
    </LinearLayout>
</ScrollView>
