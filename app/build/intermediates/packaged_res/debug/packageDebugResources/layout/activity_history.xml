<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="#F3F6FB">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Historia komunikatów" android:textSize="25sp" android:textStyle="bold"
        android:textColor="#10233F"/>
    <TextView android:id="@+id/textHistory" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:text="Brak zapisanych komunikatów."
        android:textSize="15sp" android:textColor="#344054" android:paddingTop="20dp"/>
    <TextView android:id="@+id/buttonBack" android:layout_width="match_parent" android:layout_height="54dp"
        android:gravity="center" android:text="WRÓĆ" android:textColor="#FFFFFF"
        android:textStyle="bold" android:background="@drawable/bg_primary_button"/>
</LinearLayout>
